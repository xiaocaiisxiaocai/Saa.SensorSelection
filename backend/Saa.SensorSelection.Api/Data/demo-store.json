  "process-steps:all": [
    {
      "id": 1,
      "layer": "电镀",
      "name": "PTH电镀沉铜",
      "role": "目的：镀通孔，实现多层板之间的互联\n化学沉铜：在绝缘的孔壁上形成最初的，薄的化学铜箔\n电镀铜加厚：将铜箔加厚到要求的厚度",
      "feature": "板子孔多，含铜量高，板子一般较厚",
      "note": "建议使用近接开关检测板子-输送M18,手臂M30"
    },
    {
      "id": 2,
      "layer": "电镀",
      "name": "VCP电镀",
      "role": "垂直连续电镀，垂直悬挂，连续缓慢的通过电镀槽，加厚在板子孔内和表面的铜箔厚度",
      "feature": "板子孔多，含铜量高，板子一般较厚，需垂直上料到主线",
      "note": "建议使用近接开关检测板子-输送M18,手臂M30"
    },
    {
      "id": 3,
      "layer": "电镀",
      "name": "填孔电镀",
      "role": "填充板子上的通孔/盲孔",
      "feature": "经过填孔电镀后，板子孔较少，含铜量高，板子一般较厚",
      "note": ""
    },
    {
      "id": 4,
      "layer": "电镀",
      "name": "研磨",
      "role": "分十六轴研磨和十二轴研磨，实现极致的铜面清洁度，粗糙度和附着力",
      "feature": "板子孔多，含铜量高，板子一般较厚",
      "note": ""
    }
  ],
