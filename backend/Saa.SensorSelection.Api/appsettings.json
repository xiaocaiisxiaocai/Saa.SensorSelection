{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/symtek.db"
  },
  "Jwt": {
    "Issuer": "Saa.SensorSelection.Api",
    "Audience": "Saa.SensorSelection",
    "Key": "saa-sensor-selection-dev-key-change-me-0123456789abcdef",
    "ExpireHours": 12
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin123",
    "AdminDisplayName": "管理员"
  },
  // 登录失败限流：同用户名+IP 在窗口内失败达到上限后拒绝登录
  "RateLimit": {
    "MaxFailures": 5,
    "WindowMinutes": 10
  },
  // CORS 允许来源（逗号分隔）。留空 = 允许任意来源（内网宽松模式）
  "Cors": {
    "AllowedOrigins": ""
  },
  // 操作日志保留上限（条），超出自动清理最旧记录；0 = 不限制
  "Audit": {
    "MaxEntries": 50000
  },
  // 上传请求到达后会立即剥离文件正文；保留较高上限以接收单个大文件的首次写入
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 104857600
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
