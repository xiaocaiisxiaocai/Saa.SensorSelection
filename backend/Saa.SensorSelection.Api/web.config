<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS 请求筛选默认只放行约 28.6 MB；与报告接口的 100 MB 上限对齐，否则大文件上传在 IIS 层返回 404.13。
           handlers / aspNetCore 节点由 dotnet publish 自动补齐。 -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
