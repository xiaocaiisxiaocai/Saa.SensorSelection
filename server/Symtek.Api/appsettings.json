{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/symtek.db"
  },
  "Jwt": {
    "Issuer": "Symtek.Api",
    "Audience": "Symtek.Selection",
    "Key": "symtek-selection-dev-key-change-me-0123456789abcdef",
    "ExpireHours": 12
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin123",
    "AdminDisplayName": "管理员"
  },
  // 受控文档等以 base64 存储，放宽 Kestrel 默认 30MB 请求体上限
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 104857600
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
